<section style="background:linear-gradient(rgba(0,0,0,0.55),rgba(0,0,0,0.55)),url(https://mimugarten.nl/wp-content/uploads/2026/06/Mimu-Showroom-scaled.jpg);background-size:cover;background-position:center;color:#fff;padding:64px 24px;text-align:center;border-radius:8px;margin-bottom:48px;">
