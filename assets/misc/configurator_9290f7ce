            function sync() {
                var lang = document.documentElement.lang === 'nl' ? 'nl' : 'de';
                Object.keys(T_NL).forEach(function (tag) {
                    document.querySelectorAll('[data-cky-tag="' + tag + '"]').forEach(function (el) {
