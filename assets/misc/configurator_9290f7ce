            function setText(el, tag, v) {
                if (tag === 'powered-by') {
                    for (var i = 0; i < el.childNodes.length; i++) {
                        if (el.childNodes[i].nodeType === 3 && el.childNodes[i].textContent.trim()) { el.childNodes[i].textContent = v + ' '; return; }
