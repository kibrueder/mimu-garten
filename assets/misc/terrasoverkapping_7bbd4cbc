<body class="wp-singular page-template page-template-elementor_canvas page page-id-816 wp-embed-responsive wp-theme-hello-elementor translatepress-nl_NL hello-elementor-default elementor-default elementor-template-canvas elementor-kit-8">
	<div class="mimugarten-page" style="font-family:sans-serif;max-width:1100px;margin:0 auto;padding:0 16px;box-sizing:border-box;">
<p><!-- ===== HERO ===== --></p>
<section style="background:linear-gradient(rgba(0,0,0,0.55),rgba(0,0,0,0.55)),url(https://mimugarten.nl/wp-content/uploads/2026/06/Mimu-Showroom-scaled.jpg);background-size:cover;background-position:center;color:#fff;padding:64px 24px;text-align:center;border-radius:8px;margin-bottom:48px;">
<p style="font-size:0.85rem;letter-spacing:2px;text-transform:uppercase;opacity:0.8;margin-bottom:12px;">Fabrikant uit Nederland · Showroom in Roermond</p>
<h1 style="font-size:clamp(1.4rem,4vw,2.2rem);font-weight:700;margin-bottom:16px;color:#ffffff;line-height:1.3;">Terrasoverkapping Roermond – rechtstreeks van de fabrikant uit Nederland</h1>
<p style="font-size:1rem;max-width:650px;margin:0 auto 32px;line-height:1.7;opacity:0.95;">
    Mimu Garten produceert en monteert terrasoverkappingen in Roermond en heel Noordrijn-Westfalen.<br />
    Als fabrikant uit Nederland zonder tussenpersonen – kwaliteit voor een eerlijke prijs,<br />
    met 10 jaar garantie op product en montage.
