<body class="wp-singular page-template page-template-elementor_canvas page page-id-793 wp-embed-responsive wp-theme-hello-elementor translatepress-de_DE hello-elementor-default elementor-default elementor-template-canvas elementor-kit-8">
	<div class="mimugarten-landingpage" style="font-family:sans-serif;max-width:1100px;margin:0 auto;padding:0 16px;box-sizing:border-box;">
<section style="background: linear-gradient(rgba(0,0,0,0.55),rgba(0,0,0,0.55)),url('https://mimugarten.nl/wp-content/uploads/2026/06/Mimu-Showroom-scaled.jpg'); background-size: cover; background-position: center; color: #fff; padding: 64px 24px; text-align: center; border-radius: 8px; margin-bottom: 48px;">
<p style="font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase; opacity: 0.8; margin-bottom: 12px;">Terrassenüberdachungen &amp; Glasschiebewände – Hersteller aus Roermond</p>
